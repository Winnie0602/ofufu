# 複製成 .env 後填入實際值。這個檔案只放 key 名稱與說明，不要填入真實憑證。

# --- 資料庫 ---
# MongoDB 連線字串（必填）
MONGODB_URI=
# 教材資料庫名稱，不設就用 ofufu
MONGODB_DB=ofufu

# --- 教材匯入 ---
# POST /api/admin/seed 的通行碼，自己隨便產一組長字串
# 該端點另外只在開發環境可用，正式環境一律 403
SEED_TOKEN=

# --- 語音合成 ---
# 設為 true 才啟用 Google TTS，預設關閉
# 關閉時教材頁照常可讀，只有播放鍵會拿到 503
TTS_ENABLED=
# Google Cloud service account 的 JSON（整份貼成一行）
GOOGLE_CREDENTIALS=

# --- 登入 ---
AUTH_SECRET=
AUTH_ORIGIN=http://localhost:3000/api/auth
NEXTAUTH_URL=http://localhost:3000
APP_URL=http://localhost:3000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
